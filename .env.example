# Copy to .env and fill in the key. .env is git-ignored.

# Model passed to `claude --model` for every phase
CLAUDE_MODEL=claude-sonnet-5-5
# Results folder; use one per model, e.g. runs_sonnet
RUNS_DIR=runs

# --- AI gateway (preferred): when set, it is used instead of the Grove/Foundry settings below
AI_GATEWAY_API_KEY=<your AI gateway API key>

# --- Constants
ANTHROPIC_FOUNDRY_API_KEY=<your Grove API key>
ANTHROPIC_FOUNDRY_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic
CLAUDE_CODE_USE_FOUNDRY=1
CLAUDE_CODE_SKIP_FOUNDRY_AUTH=1
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

CLAUDE_CODE_VERSION=2.1.284